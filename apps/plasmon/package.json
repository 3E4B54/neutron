{
  "name": "neutron-plasmon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts && npm run mogen",
    "mopack": "bun ../../packages/neutron-scripts/src/mopack.ts",
    "validate": "bun ../../packages/neutron-scripts/src/validate.ts",
    "mogen": "bun ../../packages/neutron-scripts/src/mogen.ts",
    "schema": "bun ../../packages/neutron-scripts/src/method_schema.ts",
    "test": "bun test ./src/fs/fs.test.ts ./src/fs/neutron-remote-adapter.test.ts ./src/os/windowing/windowing.test.ts ./src/os/process/runtime.test.ts ./src/os/associations/association.test.ts ./src/os/associations/association-runtime.test.ts ./src/games/saves/save.test.ts ./src/native-apps/jsdos/jsdos.test.ts ./src/native-apps/emulatorjs/emulatorjs.test.ts ./src/os/file-manager/file-manager.test.ts ./src/os/properties/properties.test.ts ./src/os/recycle-bin/recycle-bin.test.ts ./test/backendMethod.test.ts ./test/gamesAsset.test.ts ./test/servicesFeatureSmoke.test.ts ./test/emulatorJsRuntime.test.ts",
    "test:fast": "bun test ./src/games/saves/save.test.ts ./src/native-apps/jsdos/jsdos.test.ts ./src/native-apps/emulatorjs/emulatorjs.test.ts ./test/backendMethod.test.ts ./test/gamesAsset.test.ts ./test/servicesFeatureSmoke.test.ts ./test/fsWrite.test.ts ./test/associationOpen.test.ts ./test/fileManagerDelete.test.ts ./test/trashLifecycle.test.ts ./test/emulatorJsRuntime.test.ts",
    "package": "npm run validate && npm run build && npm run mopack && npm run schema && bun ../../packages/neutron-scripts/src/pack.ts",
    "test:package": "npm run package && bun test ./test/package.test.ts"
  },
  "neutron": {
    "generated": [
      "backend/_neutron.mo"
    ]
  },
  "exports": {
    "app": "./main.js",
    "backend": "./backend/main.mo"
  },
  "description": "Neutron OS–native desktop surface for the Neutron platform"
}
